---
import { SITE, waLink } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <svg class="mark" viewBox="0 0 46 40" aria-hidden="true">
        <polygon points="23,2 12.5,20 33.5,20" fill="#fff"></polygon>
        <polygon points="12.5,20 2,38 23,38" fill="#fff"></polygon>
        <polygon points="33.5,20 23,38 44,38" fill="#fff"></polygon>
      </svg>
      <span class="wordmark"><b>TETRA</b><i>OSSC</i></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Primary">
      <a href="/" class:list={[{ active: path === '/' }]}>Home</a>
      <a href="/#catalogue">Products</a>
      <a href="/about" class:list={[{ active: isActive('/about') }]}>About</a>
      <a class="btn btn-whatsapp nav-cta" href={waLink('Hello Tetra, I have a product enquiry from the OSSC catalogue.')} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.83-1.96-.93-.26-.09-.45-.14-.64.15-.19.28-.73.92-.9 1.11-.16.19-.33.21-.62.07a7.9 7.9 0 0 1-3.9-3.4c-.29-.5.3-.47.84-1.56.09-.18.05-.34-.02-.48-.08-.14-.64-1.54-.88-2.11-.23-.55-.47-.48-.64-.49h-.55c-.19 0-.5.07-.76.36-.26.28-1 .98-1 2.38s1.02 2.76 1.17 2.95c.14.19 2 3.05 4.85 4.28 1.8.78 2.5.85 3.4.71.55-.08 1.7-.69 1.94-1.36.24-.66.24-1.23.17-1.35-.07-.12-.26-.19-.55-.34Z"/><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        Quote
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--grad-h);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08), 0 4px 14px rgba(24, 27, 71, 0.18);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .mark {
    width: 30px;
    height: 26px;
    flex: none;
  }
  .wordmark {
    font-family: var(--font-head);
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .wordmark b {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.12em;
    color: #fff;
  }
  .wordmark i {
    font-style: normal;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #c7cef3;
  }

  .nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav > a {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.86);
    position: relative;
  }
  .nav > a:hover {
    color: #fff;
    text-decoration: none;
  }
  .nav > a.active {
    color: #fff;
  }
  .nav > a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
  }
  .nav-cta {
    padding: 9px 16px;
    font-size: 14px;
    color: #fff;
  }
  .nav-cta.active::after {
    display: none;
  }
  .nav-cta:hover {
    color: #fff;
  }

  .burger {
    display: none;
    margin-left: auto;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    cursor: pointer;
  }
  .burger span {
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 900px) {
    .burger {
      display: flex;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #2f2a83;
      box-shadow: var(--shadow);
      padding: 8px 20px 18px;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease;
    }
    .nav > a {
      padding: 13px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 16px;
      color: rgba(255, 255, 255, 0.9);
    }
    .nav > a.active::after {
      display: none;
    }
    .nav-cta {
      margin-top: 14px;
      justify-content: center;
      padding: 13px;
      border-bottom: none !important;
    }
    .nav-toggle:checked ~ .nav {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .nav-toggle:checked ~ .burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES, categoryBySlug, waLink } from '../consts';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const countFor = (slug: string) => products.filter((p) => p.data.category === slug).length;
const PAGE_SIZE = 9;
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-inner">
      <span class="eyebrow">Tetra Private Limited</span>
      <h1>Water treatment components &amp; accessories</h1>
      <p class="sub">
        The OSSC range — valves, filter media, treatment chemicals, PP filtration, UV and control
        equipment. Browse the catalogue and get a quotation on WhatsApp.
      </p>
      <div class="hero-cta">
        <a class="btn btn-whatsapp" href={waLink('Hello Tetra, I have a product enquiry from the OSSC catalogue.')} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.83-1.96-.93-.26-.09-.45-.14-.64.15-.19.28-.73.92-.9 1.11-.16.19-.33.21-.62.07a7.9 7.9 0 0 1-3.9-3.4c-.29-.5.3-.47.84-1.56.09-.18.05-.34-.02-.48-.08-.14-.64-1.54-.88-2.11-.23-.55-.47-.48-.64-.49h-.55c-.19 0-.5.07-.76.36-.26.28-1 .98-1 2.38s1.02 2.76 1.17 2.95c.14.19 2 3.05 4.85 4.28 1.8.78 2.5.85 3.4.71.55-.08 1.7-.69 1.94-1.36.24-.66.24-1.23.17-1.35-.07-.12-.26-.19-.55-.34Z"/><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          Get a quote
        </a>
        <a class="btn btn-outline light" href="#catalogue">Browse products</a>
      </div>
      <p class="hero-note">{products.length} products · {CATEGORIES.length} categories · prices on request</p>
    </div>
  </section>

  <!-- Catalogue listing -->
  <section class="wrap catalogue" id="catalogue">
    <div class="cat-head">
      <div>
        <span class="eyebrow">Catalogue</span>
        <h2>Our products</h2>
      </div>
      <div class="controls">
        <label for="cat-filter">Filter by category</label>
        <div class="select-wrap">
          <select id="cat-filter" aria-label="Filter products by category">
            <option value="all">All categories ({products.length})</option>
            {CATEGORIES.map((c) => <option value={c.slug}>{c.title} ({countFor(c.slug)})</option>)}
          </select>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>

    <p class="result-count"><span id="rc">{products.length}</span> products <span id="rc-cat"></span></p>

    <div class="grid" id="product-grid" data-page-size={PAGE_SIZE}>
      {
        products.map((p) => (
          <div class="cell" data-category={p.data.category}>
            <ProductCard product={p} />
          </div>
        ))
      }
    </div>

    <p class="empty" id="empty" hidden>No products in this category.</p>
    <nav class="pager" id="pager" aria-label="Pagination"></nav>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <h2>Need a quotation?</h2>
        <p>Tell us the products and quantities — we’ll reply on WhatsApp with current pricing.</p>
      </div>
      <a class="btn btn-whatsapp" href={waLink('Hello Tetra, I would like a quotation. Here are the products I am interested in: ')} target="_blank" rel="noopener">Message us on WhatsApp</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--grad);
    color: #eaf4fc;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    right: -80px;
    top: -60px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.14), transparent 62%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: 64px 60px;
  }
  .hero .eyebrow {
    color: var(--brand-tint);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(32px, 5.6vw, 54px);
    font-weight: 800;
    letter-spacing: -0.005em;
    margin-top: 12px;
    max-width: 15ch;
  }
  .hero .sub {
    margin-top: 16px;
    max-width: 56ch;
    font-size: 18px;
    color: #d3e6f4;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .btn-outline.light {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .btn-outline.light:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }
  .hero-note {
    margin-top: 20px;
    font-size: 13px;
    color: #bcd6ea;
    font-family: var(--font-head);
    letter-spacing: 0.02em;
  }

  /* catalogue */
  .catalogue {
    padding-block: 52px 40px;
    scroll-margin-top: calc(var(--header-h) + 8px);
  }
  .cat-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 10px;
  }
  .cat-head h2 {
    font-size: clamp(24px, 3.6vw, 34px);
    font-weight: 700;
    margin-top: 4px;
  }
  .controls {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .controls label {
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .select-wrap {
    position: relative;
  }
  .select-wrap svg {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: var(--brand);
    pointer-events: none;
  }
  #cat-filter {
    appearance: none;
    -webkit-appearance: none;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: var(--surface);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 11px 40px 11px 14px;
    min-width: 280px;
    cursor: pointer;
  }
  #cat-filter:focus {
    outline: none;
    border-color: var(--brand);
  }
  @media (max-width: 560px) {
    #cat-filter {
      min-width: 0;
      width: 100%;
    }
    .controls {
      width: 100%;
    }
  }

  .result-count {
    color: var(--ink-3);
    font-size: 14px;
    font-family: var(--font-head);
    margin-bottom: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }
  .cell.hide {
    display: none;
  }
  .empty {
    text-align: center;
    color: var(--ink-2);
    padding: 40px 0;
  }

  /* pager */
  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 34px;
  }
  .pager:empty {
    display: none;
  }
  .pager button {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 600;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.12s ease;
  }
  .pager button:hover:not(:disabled) {
    border-color: var(--brand);
    color: var(--brand);
  }
  .pager button[aria-current='true'] {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .pager button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .pager .ellipsis {
    color: var(--ink-3);
    padding: 0 4px;
  }

  .cta-band {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    padding-block: 40px;
  }
  .cta-inner h2 {
    font-size: 26px;
    font-weight: 700;
  }
  .cta-inner p {
    color: var(--ink-2);
    margin-top: 6px;
    max-width: 52ch;
  }
</style>

<script>
  const grid = document.getElementById('product-grid');
  const select = document.getElementById('cat-filter') as HTMLSelectElement | null;
  const pager = document.getElementById('pager');
  const rc = document.getElementById('rc');
  const rcCat = document.getElementById('rc-cat');
  const empty = document.getElementById('empty');
  const section = document.getElementById('catalogue');

  if (grid && select && pager) {
    const cells = Array.from(grid.querySelectorAll<HTMLElement>('.cell'));
    const pageSize = Number(grid.dataset.pageSize) || 9;
    let category = 'all';
    let page = 1;

    const labelFor = (val: string) =>
      val === 'all' ? '' : `· ${select.options[select.selectedIndex].text.replace(/\s*\(\d+\)$/, '')}`;

    const matches = (cell: HTMLElement) => category === 'all' || cell.dataset.category === category;

    function render() {
      const filtered = cells.filter(matches);
      const total = filtered.length;
      const pages = Math.max(1, Math.ceil(total / pageSize));
      if (page > pages) page = pages;
      const start = (page - 1) * pageSize;
      const end = start + pageSize;

      cells.forEach((cell) => (cell.style.display = 'none'));
      filtered.slice(start, end).forEach((cell) => (cell.style.display = ''));

      if (rc) rc.textContent = String(total);
      if (rcCat) rcCat.textContent = labelFor(category);
      if (empty) empty.hidden = total !== 0;

      buildPager(pages);
    }

    function buildPager(pages: number) {
      if (!pager) return;
      pager.innerHTML = '';
      if (pages <= 1) return;

      const mkBtn = (label: string, target: number, opts: { current?: boolean; disabled?: boolean } = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        if (opts.current) b.setAttribute('aria-current', 'true');
        if (opts.disabled) b.disabled = true;
        b.addEventListener('click', () => {
          page = target;
          render();
          section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        return b;
      };

      pager.appendChild(mkBtn('‹ Prev', page - 1, { disabled: page === 1 }));

      const nums: (number | 'e')[] = [];
      for (let i = 1; i <= pages; i++) {
        if (i === 1 || i === pages || Math.abs(i - page) <= 1) nums.push(i);
        else if (nums[nums.length - 1] !== 'e') nums.push('e');
      }
      nums.forEach((n) => {
        if (n === 'e') {
          const s = document.createElement('span');
          s.className = 'ellipsis';
          s.textContent = '…';
          pager.appendChild(s);
        } else {
          pager.appendChild(mkBtn(String(n), n, { current: n === page }));
        }
      });

      pager.appendChild(mkBtn('Next ›', page + 1, { disabled: page === pages }));
    }

    // preselect from ?cat= for shareable links
    const params = new URLSearchParams(location.search);
    const initial = params.get('cat');
    if (initial && Array.from(select.options).some((o) => o.value === initial)) {
      category = initial;
      select.value = initial;
    }

    select.addEventListener('change', () => {
      category = select.value;
      page = 1;
      const url = new URL(location.href);
      if (category === 'all') url.searchParams.delete('cat');
      else url.searchParams.set('cat', category);
      history.replaceState(null, '', url);
      render();
    });

    render();
  }
</script>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORIES, categoryBySlug } from '../../consts';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = categoryBySlug(slug!);
if (!category) return Astro.redirect('/404');

const products = (await getCollection('products'))
  .filter((p) => p.data.category === slug)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title={category.title} description={category.blurb}>
  <section class="head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <span>{category.short}</span>
      </nav>
      <h1>{category.title}</h1>
      <p>{category.blurb}</p>
      <div class="tools">
        <input
          type="search"
          id="filter"
          class="filter"
          placeholder={`Search in ${category.short}…`}
          aria-label={`Search within ${category.title}`}
        />
        <span class="count"><b id="shown">{products.length}</b> of {products.length}</span>
      </div>
    </div>
  </section>

  <section class="wrap listing">
    <div class="grid" id="grid">
      {products.map((p) => (
        <div class="cell" data-name={p.data.title.toLowerCase()}>
          <ProductCard product={p} />
        </div>
      ))}
    </div>
    <p class="empty" id="empty" hidden>No products match your search.</p>

    <div class="othercats">
      <span>Other categories:</span>
      {CATEGORIES.filter((c) => c.slug !== slug).map((c) => (
        <a href={`/category/${c.slug}`}>{c.short}</a>
      ))}
    </div>
  </section>
</Base>

<style>
  .head {
    background: var(--brand-wash);
    border-bottom: 1px solid var(--line);
    padding-block: 34px 30px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--ink-3);
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }
  .crumbs a {
    color: var(--ink-2);
  }
  .head h1 {
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .head p {
    margin-top: 8px;
    color: var(--ink-2);
    max-width: 64ch;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .filter {
    flex: 1 1 280px;
    max-width: 360px;
    font-family: var(--font-body);
    font-size: 15px;
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
  }
  .filter:focus {
    outline: none;
    border-color: var(--brand);
  }
  .count {
    font-size: 13px;
    color: var(--ink-3);
    font-family: var(--font-head);
  }
  .listing {
    padding-block: 34px 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }
  .empty {
    text-align: center;
    color: var(--ink-2);
    padding: 40px 0;
  }
  .othercats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-3);
  }
  .othercats a {
    font-family: var(--font-head);
    font-weight: 600;
  }
</style>

<script>
  const input = document.getElementById('filter') as HTMLInputElement | null;
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.cell'));
  const shown = document.getElementById('shown');
  const empty = document.getElementById('empty');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    cells.forEach((cell) => {
      const match = !q || (cell.dataset.name ?? '').includes(q);
      cell.hidden = !match;
      if (match) n++;
    });
    if (shown) shown.textContent = String(n);
    if (empty) empty.hidden = n !== 0;
  });
</script>
